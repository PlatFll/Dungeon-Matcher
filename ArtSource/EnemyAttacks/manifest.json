  "concepts": [
    {
      "name": "King_GroundThrust",
      "enemy": "King",
      "prompt": "Grip the sword in both hands, rotate the blade to point straight down. Raise the hilt to chest height while the sword remains pointing toward the ground. Pause in anticipation. Forcefully thrust the blade straight down into the ground with a deep knee bend. Hold briefly, then pull the sword back out of the ground and return exactly to the original ready stance. Clear forceful body mechanics; sword remains one rigid blade. No horizontal slash. Fixed feet and camera.",
      "jobId": "48912fcd-69f1-4321-8573-e93697a87257",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "CourtMage_FrostSeal",
      "enemy": "CourtMage",
      "prompt": "Raise the icy staff high with one hand while the other hand traces a small cyan rune. Snap the staff downward, releasing a short icy pulse and three sharp cyan shards toward the left. Recover the exact starting pose. Brief crisp spell, restrained particle count.",
      "jobId": "6f908437-78d9-48fe-9ab2-9e3232cd154d",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "CrossbowGuard_ChainShot",
      "enemy": "CrossbowGuard",
      "prompt": "Draw the crossbow back, lift and aim it left, then fire a single dark steel hooked bolt attached to a chain rapidly toward the left. Recoil visibly, loose chain links whip outward and disappear, then lower back to the start. Fixed camera.",
      "jobId": "e05889e4-3a4d-4651-88f2-5ccba43bf861",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "Archbishop_Benediction",
      "enemy": "RoyalArchbishop",
      "prompt": "Lift the golden staff overhead while opening the free palm. A compact golden halo brightens around the staff head, then a warm green healing pulse expands from the free hand. Hold the blessing pose briefly and return to the exact ready stance. Keep face, robes, equipment consistent.",
      "jobId": "72fbd0b2-28d9-4e03-8594-d106a98a1a84",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "StandardBearer_Plant",
      "enemy": "RoyalStandardBearer",
      "prompt": "Lift the banner pole up slightly with both hands, then drive the butt firmly into the ground. The banner snaps outward with a single strong cloth ripple. A narrow warm gold pulse travels out along the ground. Return to the exact initial pose, same flag emblem and rigid pole.",
      "jobId": "c9774835-f46b-4083-96ea-0ebb53d59530",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "ShieldKnight_Bulwark",
      "enemy": "ShieldKnight",
      "prompt": "Bring the shield firmly forward and brace behind it. A narrow bright cyan rim lights the edge and expands briefly into a protective shield arc. Hold the defensive stance, then relax and return exactly to the starting pose. Controlled weight shift, no new equipment.",
      "jobId": "9a04a093-00cf-4df7-8910-807c3551056b",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "Marshal_Rally",
      "enemy": "TownMarshal",
      "prompt": "Lift and vigorously ring the hand bell twice while raising the mace to signal the troops. Two short concentric gold sound rings radiate from the bell. Beard, body and blue cape follow the emphatic motion, then return exactly to the starting pose.",
      "jobId": "3c0bc749-812e-486d-a71b-41723e0802ca",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "BarricadeGuard_RaiseWall",
      "enemy": "BarricadeGuard",
      "prompt": "Kneel with a firm weight drop, lift the hammer and hammer the ground once. Two small rough timber uprights rise in front of the builder as a brief warm dust puff disperses. Stand back up to the exact initial stance. Preserve rigid hammer, square body and costume.",
      "jobId": "0d4b7a26-ad4e-4eae-9315-59e6eb2dd354",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "SiegeSergeant_HammerTime",
      "enemy": "SiegeSergeant",
      "prompt": "Grip the giant hammer, lift it over the shoulder with strong shoulder and knee anticipation, pause, then slam it forcefully into the ground to the left. Compact stone chips and a sharp amber shockwave burst outward. Pull the hammer free and recover the exact ready pose. Clear impact and recovery.",
      "jobId": "8e462e44-b949-48b5-9aa7-efeba08883a2",
      "purpose": "Ability concept; user selection pending"
    },
    {
      "name": "KnightCaptain_Command",
      "enemy": "KnightCaptain",
      "prompt": "Raise the sword upright as a command signal, point it sharply toward the LEFT edge of the image while the free fist closes at the chest, then return to ready. A compact amber signal glints at the blade tip. Stern rallying command, no speech bubble.",
      "jobId": "0d6b93dd-0d9d-44e8-be31-60a722d64629",
      "purpose": "Ability concept; user selection pending"
    },
